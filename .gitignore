# There was no .gitignore here at all, and the two things that would have been
# committed first are the two that must never be.
#
#   .env        scripts/cf.sh sources it for CLOUDFLARE_API_TOKEN, which is a
#               credential for the whole account.
#   .wrangler/  holds the local D1 database, which after any real use is a file
#               full of customers' names, addresses and coordinates.
.env
.env.*
!web/.env.production
.wrangler/
node_modules/
web/dist/
*.log

# Build and tool output. `tsc -b` writes the buildinfo next to web/tsconfig.json
# and it is a cache keyed to one machine's absolute paths; seed/ is what
# scripts/build-postal-codes.mjs generates, and a single country's file runs to
# hundreds of megabytes of SQL.
web/tsconfig.tsbuildinfo
seed/

# Vite writes a timestamped copy of the config beside it on every run and
# does not always clean them up.
vitest.config.ts.timestamp-*.mjs
